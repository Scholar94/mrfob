rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function rolePath(uid) { return /databases/(default)/documents/roles/$(uid); }
    function roleOf(uid) {
      return firestore.exists(rolePath(uid)) ? firestore.get(rolePath(uid)).data.role : 'customer';
    }
    function isAdmin() { return signedIn() && roleOf(request.auth.uid) == 'superAdmin'; }
    function isStaff() { return signedIn() && roleOf(request.auth.uid) in ['manager', 'sales', 'tailor', 'institute']; }
    function orderPath(orderId) { return /databases/(default)/documents/orders/$(orderId); }
    function orderOwner(orderId) {
      return firestore.exists(orderPath(orderId))
        ? firestore.get(orderPath(orderId)).data.customerUid : '';
    }
    match /order-progress/{orderId}/{fileName} {
      allow read: if signedIn() && (isAdmin() || isStaff() || orderOwner(orderId) == request.auth.uid);
      allow create: if signedIn()
        && (isAdmin() || roleOf(request.auth.uid) in ['manager', 'tailor'])
        && orderOwner(orderId) != ''
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.metadata.orderId == orderId
        && request.resource.metadata.uploadedBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}