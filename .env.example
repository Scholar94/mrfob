# Copy these values into GitHub Actions repository secrets or local .env (never commit real credentials).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Google Drive integration (GitHub Actions repository Variables, not Secrets).
# Requires an OAuth 2.0 Web client, Drive API enabled, and a shared upload folder.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_FOLDER_ID=

# Optional: Google Apps Script web-app URL for secure objective assessment grading.
VITE_ASSESSMENT_GRADING_URL=
