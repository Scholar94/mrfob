rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperAdmin() { return signedIn() && request.auth.token.superAdmin == true; }
    function isStaff() { return signedIn() && request.auth.token.staffRole in ['manager', 'sales', 'tailor', 'institute']; }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.accountType == 'customer'
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'accountType', 'createdAt', 'updatedAt']);
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin() || isStaff());
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'address', 'updatedAt']);
      allow delete: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || isStaff());
      allow update: if isSuperAdmin() || (isStaff() && request.auth.token.staffRole in ['manager', 'sales', 'tailor']);
      allow delete: if isSuperAdmin();
    }

    match /measurements/{measurementId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || request.auth.token.staffRole in ['manager', 'tailor']);
      allow update, delete: if isSuperAdmin() || (isStaff() && request.auth.token.staffRole in ['manager', 'tailor']);
    }

    match /trainingEnquiries/{enquiryId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read, update: if isSuperAdmin() || (isStaff() && request.auth.token.staffRole in ['manager', 'institute']);
      allow delete: if isSuperAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
