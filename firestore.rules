rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function rolePath(uid) { return /databases/$(database)/documents/roles/$(uid); }
    function roleOf(uid) {
      return exists(rolePath(uid)) ? get(rolePath(uid)).data.role : 'customer';
    }
    function isSuperAdmin() { return signedIn() && roleOf(request.auth.uid) == 'superAdmin'; }
    function isFinanceOfficer() { return signedIn() && roleOf(request.auth.uid) == 'finance'; }
    function isStaff() {
      return signedIn() && roleOf(request.auth.uid) in ['manager', 'sales', 'tailor', 'institute'];
    }
    function hasStaffRole(roles) { return isStaff() && roleOf(request.auth.uid) in roles; }

    function validQuotationItems(items, total) {
      return items is list && items.size() == 6
        && items[0] is map && items[0].keys().hasOnly(['label', 'amount']) && items[0].label == 'Garment / agreed scope' && items[0].amount is number && items[0].amount >= 0
        && items[1] is map && items[1].keys().hasOnly(['label', 'amount']) && items[1].label == 'Fabric' && items[1].amount is number && items[1].amount >= 0
        && items[2] is map && items[2].keys().hasOnly(['label', 'amount']) && items[2].label == 'Labour' && items[2].amount is number && items[2].amount >= 0
        && items[3] is map && items[3].keys().hasOnly(['label', 'amount']) && items[3].label == 'Design' && items[3].amount is number && items[3].amount >= 0
        && items[4] is map && items[4].keys().hasOnly(['label', 'amount']) && items[4].label == 'Accessories' && items[4].amount is number && items[4].amount >= 0
        && items[5] is map && items[5].keys().hasOnly(['label', 'amount']) && items[5].label == 'Delivery' && items[5].amount is number && items[5].amount >= 0
        && total is number && total == items[0].amount + items[1].amount + items[2].amount + items[3].amount + items[4].amount + items[5].amount;
    }

    match /roles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin() && userId != request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.accountType == 'customer'
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'accountType', 'createdAt', 'updatedAt']);
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin() || hasStaffRole(['manager', 'sales']));
      allow update: if (signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'address', 'updatedAt']))
        || (isSuperAdmin() && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'address', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && (
        (request.resource.data.customerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['customerUid', 'customerName', 'customerEmail', 'orderNumber', 'item', 'description', 'category', 'fabric', 'colour', 'quantity', 'measurementMethod', 'preferredDate', 'deliveryMethod', 'instructions', 'status', 'paymentStatus', 'createdAt', 'updatedAt'])
          && request.resource.data.item is string && request.resource.data.item.size() > 0
          && request.resource.data.item.size() <= 120
          && request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 50
          && request.resource.data.status == 'received'
          && request.resource.data.paymentStatus == 'unquoted'
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
        ) || (isSuperAdmin()
          && request.resource.data.keys().hasOnly(['orderNumber', 'customerUid', 'customerName', 'customerEmail', 'item', 'description', 'amount', 'currency', 'dueDate', 'status', 'paymentStatus', 'createdAt', 'updatedAt', 'createdBy'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
        )
      );
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['manager','sales']) || isFinanceOfficer() || (hasStaffRole(['tailor']) && resource.data.assignedDesignerUid == request.auth.uid));
      allow update: if (signedIn() && resource.data.customerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['instructions', 'fabric', 'colour', 'preferredDate', 'deliveryMethod', 'updatedAt'])
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus)
        || (isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'amount', 'amountPaid', 'quotationNote', 'quotationItems', 'quotationStatus', 'quotationSentAt', 'dueDate', 'assignedDesignerUid', 'assignedDesignerName', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedDesignerUid']) || request.resource.data.assignedDesignerUid == '' || (request.resource.data.assignedDesignerUid is string && roleOf(request.resource.data.assignedDesignerUid) == 'tailor'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedDesignerName']) || (request.resource.data.assignedDesignerName is string && request.resource.data.assignedDesignerName.size() <= 160))
        && (!('dueDate' in request.resource.data) || request.resource.data.dueDate is string)
        && (!('amount' in request.resource.data) || (request.resource.data.amount is number && request.resource.data.amount > 0))
        && (!('amountPaid' in request.resource.data) || (request.resource.data.amountPaid is number && request.resource.data.amountPaid >= 0))
        && (!('quotationItems' in request.resource.data) || validQuotationItems(request.resource.data.quotationItems, request.resource.data.amount))
        && (!('quotationStatus' in request.resource.data) || request.resource.data.quotationStatus in ['sent', 'accepted', 'declined']))
        || (signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.quotationStatus == 'sent'
        && request.resource.data.quotationStatus in ['accepted', 'declined']
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quotationStatus', 'updatedAt']))
        || (hasStaffRole(['manager', 'sales', 'tailor'])
        && (!hasStaffRole(['tailor']) || resource.data.assignedDesignerUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || (isFinanceOfficer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountPaid', 'paymentStatus', 'lastPaymentId', 'updatedAt'])
        && request.resource.data.amountPaid is number
        && request.resource.data.amountPaid > (('amountPaid' in resource.data) ? resource.data.amountPaid : 0)
        && request.resource.data.paymentStatus in ['part_paid', 'paid']
        && request.resource.data.lastPaymentId is string
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.customerUid == resource.data.customerUid
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.amount == request.resource.data.amountPaid - (('amountPaid' in resource.data) ? resource.data.amountPaid : 0)
        && getAfter(/databases/$(database)/documents/paymentDeclarations/$(getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.declarationId)).data.status == 'verified');
      allow delete: if isSuperAdmin();

      match /events/{eventId} {
        allow create: if (isSuperAdmin() || hasStaffRole(['manager', 'sales', 'tailor']))
          && (!hasStaffRole(['tailor']) || get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDesignerUid == request.auth.uid)
          && request.resource.data.keys().hasOnly(['fromStatus', 'toStatus', 'stageLabel', 'stageNote', 'changedByUid', 'changedByName', 'createdAt'])
          && (!('stageNote' in request.resource.data) || (request.resource.data.stageNote is string && request.resource.data.stageNote.size() <= 500))
          && request.resource.data.changedByUid == request.auth.uid
          && request.resource.data.fromStatus is string
          && request.resource.data.toStatus in ['received', 'designer_review', 'awaiting_measurements', 'measurements_completed', 'awaiting_quotation_approval', 'awaiting_deposit', 'confirmed', 'fabric_preparation', 'cutting', 'sewing', 'finishing', 'quality_control', 'ready_for_fitting', 'alterations', 'completed', 'ready_for_collection', 'dispatched', 'delivered']
          && request.resource.data.stageLabel is string
          && request.resource.data.createdAt is timestamp;
        allow read: if signedIn() && (
          isSuperAdmin() || hasStaffRole(['manager','sales']) ||
          (hasStaffRole(['tailor']) && get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDesignerUid == request.auth.uid) ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
        );
        allow update, delete: if false;
      }

      match /referenceDesigns/{referenceId} {
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid
          && request.resource.data.keys().hasOnly(['orderId','customerUid','fileId','fileName','contentType','size','driveUrl','createdAt'])
          && request.resource.data.orderId == orderId
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.fileId is string
          && request.resource.data.fileName is string
          && request.resource.data.fileName.size() > 0
          && request.resource.data.contentType in ['image/jpeg','image/png','image/webp','application/pdf']
          && request.resource.data.size is int
          && request.resource.data.size > 0 && request.resource.data.size <= 15728640
          && request.resource.data.driveUrl is string
          && request.resource.data.createdAt is timestamp;
        allow read: if signedIn() && (isSuperAdmin() || hasStaffRole(['manager','sales'])
          || (hasStaffRole(['tailor']) && get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDesignerUid == request.auth.uid)
          || get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid);
        allow update, delete: if false;
      }

      match /progressUpdates/{updateId} {
        allow create: if (isSuperAdmin() || hasStaffRole(['manager', 'tailor']))
          && (!hasStaffRole(['tailor']) || get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDesignerUid == request.auth.uid)
          && request.resource.data.keys().hasOnly(['orderId','orderNumber','customerUid','stage','stageLabel','caption','photoUrl','driveFileId','driveUrl','previewUrl','drivePreviewUrl','storagePath','fileName','contentType','size','mediaType','uploadedByUid','uploadedByName','createdAt'])
          && request.resource.data.orderId == orderId
          && request.resource.data.customerUid == get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid
          && request.resource.data.uploadedByUid == request.auth.uid
          && request.resource.data.stage is string
          && request.resource.data.caption is string && request.resource.data.caption.size() <= 240
          && request.resource.data.photoUrl is string
          && request.resource.data.driveFileId is string
          && request.resource.data.driveUrl is string
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.matches('Google Drive/[^/]+')
          && request.resource.data.contentType in ['image/jpeg','image/png','image/webp','video/mp4','video/webm','video/quicktime']
          && request.resource.data.mediaType in ['image','video']
          && request.resource.data.size is int && request.resource.data.size > 0
          && ((request.resource.data.mediaType == 'image' && request.resource.data.size <= 20971520)
            || (request.resource.data.mediaType == 'video' && request.resource.data.size <= 104857600))
          && request.resource.data.createdAt is timestamp;
        allow read: if signedIn() && (isSuperAdmin() || hasStaffRole(['manager','sales'])
          || (hasStaffRole(['tailor']) && get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDesignerUid == request.auth.uid)
          || get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /appointments/{appointmentId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['customerUid', 'customerName', 'customerEmail', 'service', 'appointmentDate', 'appointmentTime', 'purpose', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['manager', 'sales', 'institute']) || (hasStaffRole(['tailor']) && resource.data.assignedDesignerUid == request.auth.uid));
      allow update: if (
        isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'proposedDate', 'proposedTime', 'adminMessage', 'assignedDesignerUid', 'assignedDesignerName', 'orderId', 'orderNumber', 'updatedAt'])
        && request.resource.data.status in ['pending', 'confirmed', 'alternative_proposed', 'completed', 'cancelled']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedDesignerUid'])
          || request.resource.data.assignedDesignerUid == ''
          || (request.resource.data.assignedDesignerUid is string && roleOf(request.resource.data.assignedDesignerUid) == 'tailor'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['orderId'])
          || request.resource.data.orderId == ''
          || (request.resource.data.orderId is string && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerUid == resource.data.customerUid))
        && (request.resource.data.status != 'alternative_proposed'
          || (request.resource.data.proposedDate is string
            && request.resource.data.proposedTime is string))
      ) || (
        signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.status in ['pending', 'alternative_proposed']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      ) || (
        signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'alternative_proposed'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.appointmentDate == resource.data.proposedDate
        && request.resource.data.appointmentTime == resource.data.proposedTime
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'appointmentDate', 'appointmentTime', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();
    }

    match /appointmentSlots/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['appointmentId', 'customerUid', 'appointmentDate', 'appointmentTime', 'updatedAt'])
        && request.resource.data.appointmentId is string
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.customerUid == request.resource.data.customerUid
        && (isSuperAdmin() || request.resource.data.customerUid == request.auth.uid)
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.status == 'confirmed'
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.appointmentDate == request.resource.data.appointmentDate
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.appointmentTime == request.resource.data.appointmentTime;
      allow update, delete: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if ((
          (isSuperAdmin() || hasStaffRole(['manager', 'sales', 'tailor']))
          && request.resource.data.type == 'production_update'
          && request.resource.data.keys().hasOnly(['customerUid','orderId','orderNumber','type','title','message','stage','stageLabel','createdAt','readAt'])
          && request.resource.data.customerUid is string
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerUid == request.resource.data.customerUid
          && request.resource.data.stage is string
          && request.resource.data.stageLabel is string
        ) || (
          isSuperAdmin()
          && request.resource.data.type == 'payment_update'
          && request.resource.data.keys().hasOnly(['customerUid','declarationId','orderId','type','paymentStatus','title','message','createdAt','readAt'])
          && request.resource.data.customerUid is string
          && request.resource.data.declarationId is string
          && request.resource.data.orderId is string
          && getAfter(/databases/$(database)/documents/paymentDeclarations/$(request.resource.data.declarationId)).data.customerUid == request.resource.data.customerUid
          && getAfter(/databases/$(database)/documents/paymentDeclarations/$(request.resource.data.declarationId)).data.orderId == request.resource.data.orderId
          && getAfter(/databases/$(database)/documents/paymentDeclarations/$(request.resource.data.declarationId)).data.status == request.resource.data.paymentStatus
          && request.resource.data.paymentStatus in ['verified','rejected']
        ) || (
          request.resource.data.type == 'quotation_update'
          && request.resource.data.keys().hasOnly(['customerUid','orderId','type','quotationStatus','title','message','createdAt','readAt'])
          && request.resource.data.customerUid is string
          && request.resource.data.orderId is string
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerUid == request.resource.data.customerUid
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.quotationStatus == request.resource.data.quotationStatus
          && (
            ((isSuperAdmin() || hasStaffRole(['manager','sales'])) && request.resource.data.quotationStatus == 'sent')
            || (signedIn() && request.resource.data.customerUid == request.auth.uid && request.resource.data.quotationStatus in ['accepted','declined'])
          )
        ) || (
          (isSuperAdmin() || hasStaffRole(['manager','tailor']))
          && request.resource.data.type == 'production_photo'
          && request.resource.data.keys().hasOnly(['customerUid','orderId','orderNumber','type','title','message','stage','stageLabel','createdAt','readAt'])
          && request.resource.data.customerUid is string
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerUid == request.resource.data.customerUid
          && request.resource.data.stage is string
          && request.resource.data.stageLabel is string
        ) || (
          isSuperAdmin()
          && request.resource.data.type == 'training_update'
          && request.resource.data.keys().hasOnly(['customerUid','trainingEnquiryId','type','trainingStatus','title','message','createdAt','readAt'])
          && request.resource.data.customerUid is string
          && request.resource.data.trainingEnquiryId is string
          && getAfter(/databases/$(database)/documents/trainingEnquiries/$(request.resource.data.trainingEnquiryId)).data.customerUid == request.resource.data.customerUid
          && getAfter(/databases/$(database)/documents/trainingEnquiries/$(request.resource.data.trainingEnquiryId)).data.status == request.resource.data.trainingStatus
          && request.resource.data.trainingStatus in ['pending','contacted','accepted','declined','completed']
        ) || (
          isSuperAdmin()
          && request.resource.data.type == 'appointment_update'
          && request.resource.data.keys().hasOnly(['customerUid','appointmentId','type','appointmentStatus','title','message','createdAt','readAt'])
          && request.resource.data.customerUid is string
          && request.resource.data.appointmentId is string
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.customerUid == request.resource.data.customerUid
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.status == request.resource.data.appointmentStatus
          && request.resource.data.appointmentStatus in ['confirmed','alternative_proposed','completed','cancelled']
        ) || (
          isSuperAdmin()
          && request.resource.data.type == 'delivery_date_update'
          && request.resource.data.keys().hasOnly(['customerUid','orderId','orderNumber','type','title','message','dueDate','createdAt','readAt'])
          && request.resource.data.customerUid is string
          && request.resource.data.orderId is string
          && request.resource.data.dueDate is string
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerUid == request.resource.data.customerUid
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.dueDate == request.resource.data.dueDate
        ) || (
          isSuperAdmin()
          && request.resource.data.type == 'appointment_assignment'
          && request.resource.data.keys().hasOnly(['customerUid','appointmentId','type','title','message','createdAt','readAt'])
          && request.resource.data.customerUid is string
          && request.resource.data.appointmentId is string
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.customerUid == request.resource.data.customerUid
        ) || (
          (isSuperAdmin() || hasStaffRole(['manager','tailor']))
          && request.resource.data.type == 'measurement_review'
          && request.resource.data.keys().hasOnly(['customerUid','measurementId','type','verificationStatus','title','message','createdAt','readAt'])
          && request.resource.data.customerUid is string
          && request.resource.data.measurementId is string
          && getAfter(/databases/$(database)/documents/measurements/$(request.resource.data.measurementId)).data.customerUid == request.resource.data.customerUid
          && getAfter(/databases/$(database)/documents/measurements/$(request.resource.data.measurementId)).data.verificationStatus == request.resource.data.verificationStatus
          && request.resource.data.verificationStatus in ['pending','verified','revision-needed']
        ) || (
          (isSuperAdmin() || isStaff())
          && request.resource.data.type == 'support_update'
          && request.resource.data.keys().hasOnly(['customerUid','supportTicketId','type','supportStatus','title','message','createdAt','readAt'])
          && request.resource.data.customerUid is string
          && request.resource.data.supportTicketId is string
          && getAfter(/databases/$(database)/documents/supportTickets/$(request.resource.data.supportTicketId)).data.customerUid == request.resource.data.customerUid
          && getAfter(/databases/$(database)/documents/supportTickets/$(request.resource.data.supportTicketId)).data.status == request.resource.data.supportStatus
          && request.resource.data.supportStatus in ['open','in_progress','closed']
        ))
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.readAt == null;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['manager','sales','tailor']));
      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt is timestamp;
      allow delete: if isSuperAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['customerUid','customerName','customerEmail','category','subject','message','status','staffReply','createdAt','updatedAt'])
        && request.resource.data.category in ['Order enquiry','Appointment','Quotation or payment','Measurements or fitting','Fashion Institute','Complaint or other']
        && request.resource.data.subject is string && request.resource.data.subject.size() >= 4 && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'open'
        && request.resource.data.staffReply == ''
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || isStaff());
      allow update: if (isSuperAdmin() || isStaff())
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.subject == resource.data.subject
        && request.resource.data.message == resource.data.message
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staffReply','repliedBy','repliedAt','status','statusUpdatedBy','updatedAt'])
        && request.resource.data.status in ['open','in_progress','closed']
        && request.resource.data.updatedAt is timestamp
        && (!('staffReply' in request.resource.data) || (request.resource.data.staffReply is string && request.resource.data.staffReply.size() <= 2000))
        && (!('repliedBy' in request.resource.data) || (request.resource.data.repliedBy == request.auth.uid && request.resource.data.repliedAt is timestamp))
        && (!('statusUpdatedBy' in request.resource.data) || request.resource.data.statusUpdatedBy == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    match /publicSettings/{settingId} {
      allow read: if settingId == 'siteProfile' || (signedIn() && settingId == 'paymentInstructions');
      allow create, update: if isSuperAdmin() && settingId == 'siteProfile'
        && request.resource.data.keys().hasOnly(['companyName','phone','whatsapp','email','address','openingHours','mission','vision','businessScope','updatedAt','updatedBy'])
        && request.resource.data.companyName is string && request.resource.data.companyName.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.openingHours is string && request.resource.data.openingHours.size() <= 300
        && request.resource.data.mission is string && request.resource.data.mission.size() <= 600
        && request.resource.data.vision is string && request.resource.data.vision.size() <= 600
        && request.resource.data.businessScope is string && request.resource.data.businessScope.size() <= 1000
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      allow create, update: if isSuperAdmin() && settingId == 'paymentInstructions'
        && request.resource.data.keys().hasOnly(['bankName','accountName','accountNumber','instructions','updatedAt','updatedBy'])
        && request.resource.data.bankName is string && request.resource.data.bankName.size() <= 80
        && request.resource.data.accountName is string && request.resource.data.accountName.size() <= 100
        && request.resource.data.accountNumber is string
        && (request.resource.data.accountNumber == '' || request.resource.data.accountNumber.matches('^[0-9]{10}$'))
        && request.resource.data.instructions is string && request.resource.data.instructions.size() <= 600
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isSuperAdmin() && settingId in ['paymentInstructions','siteProfile'];
    }



    match /paymentDeclarations/{declarationId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['orderId', 'orderNumber', 'customerUid', 'customerName', 'amount', 'currency', 'method', 'reference', 'transferDate', 'payerName', 'note', 'status', 'evidenceFileId', 'evidenceFileName', 'evidenceContentType', 'evidenceSize', 'evidenceDriveUrl', 'createdAt', 'updatedAt'])
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.reference is string && request.resource.data.reference.size() > 0 && request.resource.data.reference.size() <= 120
        && request.resource.data.transferDate is string
        && request.resource.data.status == 'pending'
        && request.resource.data.evidenceFileId is string && request.resource.data.evidenceFileId.size() > 0
        && request.resource.data.evidenceFileName is string && request.resource.data.evidenceFileName.size() > 0 && request.resource.data.evidenceFileName.size() <= 180
        && request.resource.data.evidenceContentType in ['image/jpeg','image/png','image/webp','application/pdf']
        && request.resource.data.evidenceSize is int && request.resource.data.evidenceSize > 0 && request.resource.data.evidenceSize <= 15728640
        && request.resource.data.evidenceDriveUrl is string && request.resource.data.evidenceDriveUrl.matches('https://drive\\.google\\.com/.*')
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || isFinanceOfficer());
      allow update: if (isSuperAdmin() || isFinanceOfficer())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedAt', 'reviewedBy', 'updatedAt'])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['verified', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt is timestamp
        && (request.resource.data.status != 'verified' || (
          getAfter(/databases/$(database)/documents/payments/$(declarationId)).data.declarationId == declarationId
          && getAfter(/databases/$(database)/documents/payments/$(declarationId)).data.orderId == resource.data.orderId
          && getAfter(/databases/$(database)/documents/payments/$(declarationId)).data.customerUid == resource.data.customerUid
          && getAfter(/databases/$(database)/documents/payments/$(declarationId)).data.amount == resource.data.amount
          && getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.lastPaymentId is string
          && getAfter(/databases/$(database)/documents/payments/$(getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.lastPaymentId)).data.declarationId == declarationId
        ));
      allow delete: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow create: if (isSuperAdmin() || isFinanceOfficer())
        && request.resource.data.keys().hasOnly(['orderId', 'orderNumber', 'customerUid', 'customerName', 'amount', 'currency', 'method', 'reference', 'note', 'declarationId', 'createdAt', 'createdBy'])
        && (isSuperAdmin() || (request.resource.data.declarationId is string
          && getAfter(/databases/$(database)/documents/paymentDeclarations/$(request.resource.data.declarationId)).data.status == 'verified'
          && getAfter(/databases/$(database)/documents/paymentDeclarations/$(request.resource.data.declarationId)).data.orderId == request.resource.data.orderId
          && getAfter(/databases/$(database)/documents/paymentDeclarations/$(request.resource.data.declarationId)).data.customerUid == request.resource.data.customerUid
          && getAfter(/databases/$(database)/documents/paymentDeclarations/$(request.resource.data.declarationId)).data.amount == request.resource.data.amount))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || isFinanceOfficer());
      allow update, delete: if isSuperAdmin();
    }


    match /refunds/{refundId} {
      allow create: if signedIn()
        && roleOf(request.auth.uid) == 'customer'
        && request.resource.data.keys().hasOnly(['paymentId','orderId','orderNumber','customerUid','customerEmail','amount','currency','reason','status','reviewNote','refundReference','createdAt','updatedAt'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.paymentId is string
        && refundId == request.resource.data.paymentId
        && request.resource.data.currency == 'NGN'
        && exists(/databases/$(database)/documents/payments/$(request.resource.data.paymentId))
        && get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.customerUid == request.auth.uid
        && request.resource.data.orderId == get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.orderId
        && request.resource.data.orderNumber == get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.orderNumber
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.amount <= get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.amount
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 1200
        && request.resource.data.status == 'requested'
        && request.resource.data.reviewNote == ''
        && request.resource.data.refundReference == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || isFinanceOfficer());
      allow update: if (isSuperAdmin() || isFinanceOfficer())
        && resource.data.status in ['requested','reviewing','approved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','refundReference','reviewedBy','updatedAt','processedAt'])
        && request.resource.data.status in ['reviewing','approved','rejected','paid']
        && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 1200
        && request.resource.data.refundReference is string && request.resource.data.refundReference.size() <= 120
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && (request.resource.data.status != 'paid' || (
          resource.data.status == 'approved'
          && request.resource.data.refundReference.size() > 0
          && request.resource.data.processedAt is timestamp
        ))
        && (request.resource.data.status == 'paid' || !('processedAt' in request.resource.data));
      allow delete: if isSuperAdmin();
    }

    match /expenses/{expenseId} {
      allow create: if (isSuperAdmin() || isFinanceOfficer())
        && request.resource.data.keys().hasOnly(['title', 'category', 'amount', 'currency', 'expenseDate', 'method', 'note', 'createdAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.expenseDate is string
        && request.resource.data.category is string
        && request.resource.data.method is string;
      allow read: if isSuperAdmin() || hasStaffRole(['manager']) || isFinanceOfficer();
      allow update, delete: if isSuperAdmin();
    }

    match /sales/{saleId} {
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['receiptNumber', 'customerName', 'items', 'subtotal', 'total', 'totalCost', 'grossProfit', 'amountPaid', 'balance', 'paymentStatus', 'paymentMethod', 'currency', 'createdAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.receiptNumber is string
        && request.resource.data.items is list
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.totalCost is number && request.resource.data.totalCost >= 0
        && request.resource.data.grossProfit is number
        && request.resource.data.amountPaid is number && request.resource.data.amountPaid >= 0
        && request.resource.data.balance is number && request.resource.data.balance >= 0
        && request.resource.data.paymentStatus in ['unpaid', 'part_paid', 'paid'];
      allow read: if isSuperAdmin() || hasStaffRole(['manager', 'sales']) || isFinanceOfficer();
      allow update, delete: if isSuperAdmin();
    }

    match /reviews/{orderId} {
      allow read: if (signedIn() && resource.data.customerUid == request.auth.uid)
        || isSuperAdmin()
        || hasStaffRole(['manager'])
        || resource.data.status == 'approved';
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orderId', 'customerUid', 'customerName', 'rating', 'comment', 'status', 'createdAt'])
        && request.resource.data.orderId == orderId
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 10 && request.resource.data.comment.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && !exists(/databases/$(database)/documents/reviews/$(orderId))
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'delivered';
      allow update: if (isSuperAdmin() || hasStaffRole(['manager']))
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedAt', 'moderatedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt is timestamp;
      allow delete: if isSuperAdmin();
    }

    match /customerFavourites/{customerUid}/items/{productId} {
      allow read: if signedIn() && request.auth.uid == customerUid;
      allow create: if signedIn()
        && request.auth.uid == customerUid
        && request.resource.data.keys().hasOnly(['customerUid', 'productId', 'productName', 'createdAt'])
        && request.resource.data.customerUid == customerUid
        && request.resource.data.productId == productId
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 160
        && exists(/databases/$(database)/documents/products/$(productId))
        && get(/databases/$(database)/documents/products/$(productId)).data.active == true;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == customerUid;
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['name', 'sku', 'category', 'description', 'price', 'costPrice', 'currency', 'stock', 'imageUrl', 'galleryImages', 'availableColors', 'fabricOptions', 'customizationOptions', 'active', 'createdAt', 'updatedAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
        && request.resource.data.sku is string && request.resource.data.sku.size() > 0 && request.resource.data.sku.size() <= 80
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.costPrice is number && request.resource.data.costPrice >= 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 1500
        && request.resource.data.galleryImages is list && request.resource.data.galleryImages.size() <= 8
        && request.resource.data.availableColors is list && request.resource.data.availableColors.size() <= 12
        && request.resource.data.fabricOptions is list && request.resource.data.fabricOptions.size() <= 12
        && request.resource.data.customizationOptions is list && request.resource.data.customizationOptions.size() <= 12;
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'sku', 'category', 'description', 'price', 'costPrice', 'imageUrl', 'galleryImages', 'availableColors', 'fabricOptions', 'customizationOptions', 'active', 'stock', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
        && request.resource.data.sku is string && request.resource.data.sku.size() > 0 && request.resource.data.sku.size() <= 80
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.costPrice is number && request.resource.data.costPrice >= 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 1500
        && (!('galleryImages' in request.resource.data) || (request.resource.data.galleryImages is list && request.resource.data.galleryImages.size() <= 8))
        && (!('availableColors' in request.resource.data) || (request.resource.data.availableColors is list && request.resource.data.availableColors.size() <= 12))
        && (!('fabricOptions' in request.resource.data) || (request.resource.data.fabricOptions is list && request.resource.data.fabricOptions.size() <= 12))
        && (!('customizationOptions' in request.resource.data) || (request.resource.data.customizationOptions is list && request.resource.data.customizationOptions.size() <= 12));
      allow delete: if isSuperAdmin();
    }

    match /inventoryMovements/{movementId} {
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['productId', 'productName', 'sku', 'type', 'quantity', 'previousStock', 'newStock', 'createdAt', 'createdBy', 'reason', 'receiptNumber'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ['in', 'out']
        && request.resource.data.quantity is int && request.resource.data.quantity > 0
        && request.resource.data.previousStock is int && request.resource.data.previousStock >= 0
        && request.resource.data.newStock is int && request.resource.data.newStock >= 0;
      allow read: if isSuperAdmin() || hasStaffRole(['manager']);
      allow update, delete: if isSuperAdmin();
    }

    match /measurements/{measurementId} {
      allow create: if signedIn() && (
        (request.resource.data.customerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['customerUid', 'customerName', 'profileName', 'garmentType', 'chest', 'waist', 'hip', 'shoulder', 'sleeve', 'length', 'neck', 'inseam', 'bicep', 'wrist', 'armhole', 'shirtLength', 'acrossBack', 'outseam', 'thigh', 'knee', 'ankle', 'frontRise', 'backRise', 'bust', 'underBust', 'bustPoint', 'dressLength', 'waistToHip', 'skirtLength', 'jacketLength', 'blouseLength', 'abdomen', 'upperArm', 'elbow', 'shoulderToBust', 'bustSeparation', 'frontWaistLength', 'backWaistLength', 'upperWaist', 'crotch', 'trouserWaist', 'trouserHip', 'notes', 'createdAt', 'updatedAt'])
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp)
        || ((isSuperAdmin() || hasStaffRole(['manager', 'tailor']))
          && request.resource.data.keys().hasOnly(['customerUid', 'customerName', 'profileName', 'garmentType', 'chest', 'waist', 'hip', 'shoulder', 'sleeve', 'length', 'neck', 'inseam', 'bicep', 'wrist', 'armhole', 'shirtLength', 'acrossBack', 'outseam', 'thigh', 'knee', 'ankle', 'frontRise', 'backRise', 'bust', 'underBust', 'bustPoint', 'dressLength', 'waistToHip', 'skirtLength', 'jacketLength', 'blouseLength', 'abdomen', 'upperArm', 'elbow', 'shoulderToBust', 'bustSeparation', 'frontWaistLength', 'backWaistLength', 'upperWaist', 'crotch', 'trouserWaist', 'trouserHip', 'notes', 'entrySource', 'createdByUid', 'createdByName', 'verificationStatus', 'verificationNote', 'createdAt', 'updatedAt'])
          && request.resource.data.customerUid is string
          && get(/databases/$(database)/documents/users/$(request.resource.data.customerUid)).data.accountType == 'customer'
          && request.resource.data.entrySource == 'designer'
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.verificationStatus == 'pending'
          && request.resource.data.verificationNote == ''
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp)
      );
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['manager', 'tailor']));
      allow update: if signedIn() && (
        (resource.data.customerUid == request.auth.uid
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerName', 'profileName', 'garmentType', 'chest', 'waist', 'hip', 'shoulder', 'sleeve', 'length', 'neck', 'inseam', 'bicep', 'wrist', 'armhole', 'shirtLength', 'acrossBack', 'outseam', 'thigh', 'knee', 'ankle', 'frontRise', 'backRise', 'bust', 'underBust', 'bustPoint', 'dressLength', 'waistToHip', 'skirtLength', 'jacketLength', 'blouseLength', 'abdomen', 'upperArm', 'elbow', 'shoulderToBust', 'bustSeparation', 'frontWaistLength', 'backWaistLength', 'upperWaist', 'crotch', 'trouserWaist', 'trouserHip', 'notes', 'updatedAt']))
        || ((isSuperAdmin() || hasStaffRole(['manager', 'tailor']))
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus', 'verificationNote', 'verifiedByUid', 'verifiedByName', 'verifiedAt', 'updatedAt'])
          && request.resource.data.verificationStatus in ['pending', 'verified', 'revision-needed']
          && request.resource.data.verificationNote is string
          && request.resource.data.verificationNote.size() <= 1000
          && request.resource.data.verifiedByUid == request.auth.uid
          && request.resource.data.verifiedAt is timestamp
          && request.resource.data.updatedAt is timestamp)
      );
      allow delete: if isSuperAdmin() || hasStaffRole(['manager', 'tailor']);
    }

    match /trainingEnquiries/{enquiryId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['customerUid', 'customerName', 'customerEmail', 'course', 'mode', 'message', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['manager', 'institute']));
      allow update: if (isSuperAdmin() || hasStaffRole(['manager', 'institute']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'contacted', 'accepted', 'declined', 'completed'];
      allow delete: if isSuperAdmin();
    }

    function isActiveInstituteCourse(courseId) {
      return exists(/databases/$(database)/documents/instituteCourses/$(courseId))
        && get(/databases/$(database)/documents/instituteCourses/$(courseId)).data.active != false;
    }

    match /instituteCourses/{courseId} {
      allow read: if true;
      allow create: if isSuperAdmin() || hasStaffRole(['institute','manager']);
      allow update: if isSuperAdmin() || hasStaffRole(['institute','manager']);
      allow delete: if isSuperAdmin();
    }

    match /trainingWindows/{windowId} {
      allow read: if true;
      allow create: if isActiveInstituteCourse(request.resource.data.courseId) && (isSuperAdmin() || hasStaffRole(['institute','manager']));
      allow update: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledCount','lastApplicationId','updatedAt'])
          && resource.data.status == 'open'
          && resource.data.enrolledCount is int
          && resource.data.capacity is int
          && request.resource.data.enrolledCount is int
          && request.resource.data.enrolledCount == resource.data.enrolledCount + 1
          && request.resource.data.enrolledCount <= resource.data.capacity
          && request.resource.data.lastApplicationId is string
          && request.resource.data.updatedAt is timestamp
          && getAfter(/databases/$(database)/documents/instituteApplications/$(request.resource.data.lastApplicationId)).data.customerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/instituteApplications/$(request.resource.data.lastApplicationId)).data.windowId == windowId
          && getAfter(/databases/$(database)/documents/instituteApplications/$(request.resource.data.lastApplicationId)).data.status == 'pending');
      allow delete: if isSuperAdmin();
    }

    match /instituteApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'not_due'
        && request.resource.data.applicationRef is string
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.courseId is string
        && request.resource.data.windowId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && get(/databases/$(database)/documents/trainingWindows/$(request.resource.data.windowId)).data.status == 'open'
        && get(/databases/$(database)/documents/trainingWindows/$(request.resource.data.windowId)).data.courseId == request.resource.data.courseId
        && getAfter(/databases/$(database)/documents/trainingWindows/$(request.resource.data.windowId)).data.lastApplicationId == applicationId
        && getAfter(/databases/$(database)/documents/trainingWindows/$(request.resource.data.windowId)).data.enrolledCount == get(/databases/$(database)/documents/trainingWindows/$(request.resource.data.windowId)).data.enrolledCount + 1
        && request.resource.data.keys().hasOnly(['applicationRef','customerUid','fullName','email','phone','address','courseId','courseTitle','windowId','windowTitle','mode','experience','note','status','paymentStatus','createdAt','updatedAt']);
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['institute','manager']));
      allow update: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','studentId','reviewedBy','reviewedAt','paymentStatus','paymentVerifiedBy','paymentVerifiedAt','updatedAt','withdrawalReason','withdrawnBy','withdrawnAt'])
        && request.resource.data.status in ['pending','admitted','rejected','more_information','withdrawn']
        && request.resource.data.updatedAt is timestamp
        && (resource.data.status != 'rejected' || request.resource.data.status == 'rejected')
        && (resource.data.status != 'withdrawn' || request.resource.data.status == 'withdrawn')
        && (request.resource.data.status != 'withdrawn' || (
          request.resource.data.withdrawalReason is string
          && request.resource.data.withdrawalReason.size() >= 5
          && request.resource.data.withdrawalReason.size() <= 500
          && request.resource.data.withdrawnBy == request.auth.uid
          && request.resource.data.withdrawnAt is timestamp
        ))
        && (!(request.resource.data.status in ['rejected','withdrawn']) || resource.data.status in ['rejected','withdrawn']
          || getAfter(/databases/$(database)/documents/trainingWindows/$(resource.data.windowId)).data.enrolledCount
            == get(/databases/$(database)/documents/trainingWindows/$(resource.data.windowId)).data.enrolledCount - 1);
      allow delete: if isSuperAdmin();
    }

    match /instituteEnrollments/{enrollmentId} {
      function validVerifiedEnrollment(data) {
        return data.keys().hasOnly(['studentUid','applicationId','applicationRef','studentId','studentName','studentEmail','courseId','courseTitle','windowId','windowTitle','paymentStatus','verifiedBy','verifiedAt','createdAt','enrollmentStatus','withdrawalReason','withdrawnBy','withdrawnAt','updatedAt'])
          && data.studentUid is string
          && data.courseId is string
          && enrollmentId == data.studentUid + '_' + data.courseId
          && data.applicationId is string
          && exists(/databases/$(database)/documents/instituteApplications/$(data.applicationId))
          && getAfter(/databases/$(database)/documents/instituteApplications/$(data.applicationId)).data.customerUid == data.studentUid
          && getAfter(/databases/$(database)/documents/instituteApplications/$(data.applicationId)).data.courseId == data.courseId
          && getAfter(/databases/$(database)/documents/instituteApplications/$(data.applicationId)).data.windowId == data.windowId
          && ((('enrollmentStatus' in data) && data.enrollmentStatus == 'withdrawn'
              && getAfter(/databases/$(database)/documents/instituteApplications/$(data.applicationId)).data.status == 'withdrawn')
            || ((!('enrollmentStatus' in data) || data.enrollmentStatus == 'active')
              && getAfter(/databases/$(database)/documents/instituteApplications/$(data.applicationId)).data.status == 'admitted'))
          && data.studentEmail == getAfter(/databases/$(database)/documents/instituteApplications/$(data.applicationId)).data.email
          && data.courseTitle == getAfter(/databases/$(database)/documents/instituteApplications/$(data.applicationId)).data.courseTitle
          && data.windowTitle == getAfter(/databases/$(database)/documents/instituteApplications/$(data.applicationId)).data.windowTitle
          && data.paymentStatus == 'paid'
          && data.verifiedBy is string
          && data.verifiedAt is timestamp
          && data.createdAt is timestamp
          && (!('enrollmentStatus' in data) || data.enrollmentStatus in ['active','withdrawn'])
          && (!('withdrawalReason' in data) || (data.withdrawalReason is string && data.withdrawalReason.size() >= 5 && data.withdrawalReason.size() <= 500))
          && (!('withdrawnBy' in data) || data.withdrawnBy is string)
          && (!('withdrawnAt' in data) || data.withdrawnAt is timestamp)
          && (!('updatedAt' in data) || data.updatedAt is timestamp);
      }
      allow create: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && validVerifiedEnrollment(request.resource.data)
        && request.resource.data.verifiedBy == request.auth.uid;
      allow update: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && validVerifiedEnrollment(request.resource.data)
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.applicationId == resource.data.applicationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.verifiedBy == resource.data.verifiedBy
        && request.resource.data.verifiedAt == resource.data.verifiedAt
        && request.resource.data.paymentStatus == resource.data.paymentStatus;
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId));
      allow delete: if isSuperAdmin();
    }

    function hasInstructorCourseAccess(courseId) {
      let assignmentId = request.auth.uid + '_' + courseId;
      return signedIn()
        && roleOf(request.auth.uid) == 'instructor'
        && exists(/databases/$(database)/documents/instituteInstructorAssignments/$(assignmentId))
        && get(/databases/$(database)/documents/instituteInstructorAssignments/$(assignmentId)).data.active == true;
    }

    function hasPaidEnrollmentForStudent(courseId, studentUid) {
      let enrollmentId = studentUid + '_' + courseId;
      return exists(/databases/$(database)/documents/instituteEnrollments/$(enrollmentId))
        && get(/databases/$(database)/documents/instituteEnrollments/$(enrollmentId)).data.paymentStatus == 'paid'
        && (!('enrollmentStatus' in get(/databases/$(database)/documents/instituteEnrollments/$(enrollmentId)).data)
          || get(/databases/$(database)/documents/instituteEnrollments/$(enrollmentId)).data.enrollmentStatus == 'active');
    }

    function hasPaidCourseAccess(courseId) {
      let enrollmentId = request.auth.uid + '_' + courseId;
      return signedIn()
        && exists(/databases/$(database)/documents/instituteEnrollments/$(enrollmentId))
        && get(/databases/$(database)/documents/instituteEnrollments/$(enrollmentId)).data.paymentStatus == 'paid'
        && (!('enrollmentStatus' in get(/databases/$(database)/documents/instituteEnrollments/$(enrollmentId)).data)
          || get(/databases/$(database)/documents/instituteEnrollments/$(enrollmentId)).data.enrollmentStatus == 'active');
    }

    match /instituteAssignments/{assignmentId} {
      allow create: if isActiveInstituteCourse(request.resource.data.courseId)
        && (isSuperAdmin() || hasStaffRole(['institute','manager']) || (hasInstructorCourseAccess(request.resource.data.courseId) && request.resource.data.createdBy == request.auth.uid))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.instructions is string
        && request.resource.data.instructions.size() > 0
        && request.resource.data.published == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['dueAt']) || request.resource.data.dueAt == null || request.resource.data.dueAt is timestamp);
      allow update: if isSuperAdmin() || hasStaffRole(['institute','manager']) || (hasInstructorCourseAccess(resource.data.courseId) && request.resource.data.courseId == resource.data.courseId);
      allow read: if isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId)
        || (resource.data.published == true && hasPaidCourseAccess(resource.data.courseId));
      allow delete: if isSuperAdmin();
    }

    match /instituteSubmissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && hasPaidCourseAccess(request.resource.data.courseId)
        && request.resource.data.status == 'submitted'
        && request.resource.data.answer is string
        && request.resource.data.assignmentId is string
        && exists(/databases/$(database)/documents/instituteAssignments/$(request.resource.data.assignmentId))
        && get(/databases/$(database)/documents/instituteAssignments/$(request.resource.data.assignmentId)).data.courseId == request.resource.data.courseId
        && get(/databases/$(database)/documents/instituteAssignments/$(request.resource.data.assignmentId)).data.published == true
        && (!get(/databases/$(database)/documents/instituteAssignments/$(request.resource.data.assignmentId)).data.keys().hasAny(['dueAt']) || get(/databases/$(database)/documents/instituteAssignments/$(request.resource.data.assignmentId)).data.dueAt == null || request.time <= get(/databases/$(database)/documents/instituteAssignments/$(request.resource.data.assignmentId)).data.dueAt)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['assignmentId','courseId','assignmentTitle','studentUid','studentName','answer','status','submittedAt','createdAt','updatedAt']);
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId));
      allow update: if (!resource.data.keys().hasAny(['gradingMode']) || resource.data.gradingMode != 'automatic')
        && (isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','score','maxScore','feedback','gradedBy','gradedAt','updatedAt'])
        && request.resource.data.status == 'graded'
        && exists(/databases/$(database)/documents/instituteAssignments/$(resource.data.assignmentId))
        && get(/databases/$(database)/documents/instituteAssignments/$(resource.data.assignmentId)).data.courseId == resource.data.courseId
        && request.resource.data.score is number
        && request.resource.data.maxScore is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.maxScore
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSuperAdmin();
    }

    match /instituteLessons/{lessonId} {
      allow create: if isActiveInstituteCourse(request.resource.data.courseId) && (isSuperAdmin() || hasStaffRole(['institute','manager']) || (hasInstructorCourseAccess(request.resource.data.courseId) && request.resource.data.createdBy == request.auth.uid));
      allow update: if isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId);
      allow read: if isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId)
        || (resource.data.published == true && hasPaidCourseAccess(resource.data.courseId));
      allow delete: if isSuperAdmin();
    }

    match /instituteLessonProgress/{progressId} {
      allow create, update: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && hasPaidCourseAccess(request.resource.data.courseId)
        && request.resource.data.lessonId is string
        && request.resource.data.completed == true
        && request.resource.data.completedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['studentUid','courseId','lessonId','lessonTitle','completed','completedAt','updatedAt']);
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['institute','manager']));
      allow delete: if isSuperAdmin();
    }

    match /instituteAnnouncements/{announcementId} {
      allow create: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && request.resource.data.courseId is string
        && (request.resource.data.courseId == 'all' || isActiveInstituteCourse(request.resource.data.courseId))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.audience in ['all_students','paid_course_students']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['courseId','title','message','expiresOn','audience','createdBy','createdAt','updatedAt']);
      allow read: if isSuperAdmin() || hasStaffRole(['institute','manager'])
        || (signedIn() && (resource.data.courseId == 'all' || hasPaidCourseAccess(resource.data.courseId)));
      allow update: if isSuperAdmin() || hasStaffRole(['institute','manager']);
      allow delete: if isSuperAdmin();
    }

    match /instituteCompletionApprovals/{approvalId} {
      allow create: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && approvalId == request.resource.data.studentUid + '_' + request.resource.data.courseId
        && request.resource.data.studentUid is string
        && request.resource.data.courseId is string
        && request.resource.data.certificateRef is string
        && request.resource.data.status == 'approved'
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.checks is list
        && request.resource.data.checks.size() == 4
        && request.resource.data.checks[0].complete == true
        && request.resource.data.checks[1].complete == true
        && request.resource.data.checks[2].complete == true
        && request.resource.data.checks[3].complete == true
        && request.resource.data.keys().hasOnly(['studentUid','courseId','certificateRef','status','checks','approvedBy','approvedAt','createdAt'])
        && exists(/databases/$(database)/documents/instituteEnrollments/$(request.resource.data.studentUid + '_' + request.resource.data.courseId))
        && get(/databases/$(database)/documents/instituteEnrollments/$(request.resource.data.studentUid + '_' + request.resource.data.courseId)).data.paymentStatus == 'paid';
      allow read: if isSuperAdmin() || hasStaffRole(['institute','manager']);
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /instituteCertificates/{certificateId} {
      allow create: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && request.resource.data.studentUid is string
        && request.resource.data.courseId is string
        && request.resource.data.certificateRef is string
        && request.resource.data.certificateRef.size() > 0
        && request.resource.data.status == 'issued'
        && request.resource.data.issuedBy == request.auth.uid
        && request.resource.data.issuedAt is timestamp
        && request.resource.data.keys().hasOnly(['certificateRef','studentUid','studentId','studentName','courseId','courseTitle','windowId','windowTitle','status','issuedAt','issuedBy','createdAt'])
        && exists(/databases/$(database)/documents/instituteEnrollments/$(request.resource.data.studentUid + '_' + request.resource.data.courseId))
        && get(/databases/$(database)/documents/instituteEnrollments/$(request.resource.data.studentUid + '_' + request.resource.data.courseId)).data.paymentStatus == 'paid'
        && existsAfter(/databases/$(database)/documents/instituteCompletionApprovals/$(request.resource.data.studentUid + '_' + request.resource.data.courseId))
        && getAfter(/databases/$(database)/documents/instituteCompletionApprovals/$(request.resource.data.studentUid + '_' + request.resource.data.courseId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/instituteCompletionApprovals/$(request.resource.data.studentUid + '_' + request.resource.data.courseId)).data.certificateRef == request.resource.data.certificateRef
        && getAfter(/databases/$(database)/documents/instituteCompletionApprovals/$(request.resource.data.studentUid + '_' + request.resource.data.courseId)).data.approvedBy == request.auth.uid;
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['institute','manager']));
      allow update: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revocationReason','revokedBy','revokedAt','updatedAt'])
        && resource.data.status == 'issued'
        && request.resource.data.status == 'revoked'
        && request.resource.data.revocationReason is string
        && request.resource.data.revocationReason.size() >= 8
        && request.resource.data.revocationReason.size() <= 500
        && request.resource.data.revokedBy == request.auth.uid
        && request.resource.data.revokedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSuperAdmin();
    }

    match /publicCertificateVerifications/{certificateRef} {
      allow get: if true;
      allow list: if false;
      allow create, update: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && request.resource.data.certificateRef == certificateRef
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.courseTitle is string
        && request.resource.data.status in ['issued','revoked']
        && request.resource.data.issuedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['certificateRef','studentName','courseTitle','windowTitle','status','issuedAt','revokedAt','revocationReason','updatedAt']);
      allow delete: if isSuperAdmin();
    }

    match /instituteSessions/{sessionId} {
      allow create: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && request.resource.data.courseId is string
        && isActiveInstituteCourse(request.resource.data.courseId)
        && request.resource.data.instructorUid is string
        && exists(/databases/$(database)/documents/instituteInstructorAssignments/$(request.resource.data.instructorUid + '_' + request.resource.data.courseId))
        && get(/databases/$(database)/documents/instituteInstructorAssignments/$(request.resource.data.instructorUid + '_' + request.resource.data.courseId)).data.active == true
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.startsAt is string
        && request.resource.data.endsAt is string
        && request.resource.data.endsAt > request.resource.data.startsAt
        && request.resource.data.mode in ['Onsite','Online']
        && request.resource.data.status == 'scheduled'
        && request.resource.data.published == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['courseId','courseTitle','instructorUid','title','startsAt','endsAt','mode','venue','meetingUrl','notes','status','published','createdBy','createdAt','updatedAt']);
      allow read: if isSuperAdmin() || hasStaffRole(['institute','manager'])
        || (signedIn() && resource.data.instructorUid == request.auth.uid && hasInstructorCourseAccess(resource.data.courseId))
        || (signedIn() && resource.data.published == true && hasPaidCourseAccess(resource.data.courseId));
      allow update: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['scheduled','completed','cancelled']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSuperAdmin();
    }

    match /instituteAttendance/{attendanceId} {
      allow create: if (isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(request.resource.data.courseId))
        && request.resource.data.studentUid is string
        && request.resource.data.courseId is string
        && ((isSuperAdmin() || hasStaffRole(['institute','manager'])) || hasPaidEnrollmentForStudent(request.resource.data.courseId, request.resource.data.studentUid))
        && request.resource.data.date is string
        && request.resource.data.status in ['present','absent','late','excused']
        && request.resource.data.markedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['studentUid','studentId','studentName','courseId','courseTitle','windowId','date','status','markedBy','markedAt','updatedAt']);
      allow update: if (isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId))
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.courseId == resource.data.courseId
        && ((isSuperAdmin() || hasStaffRole(['institute','manager'])) || hasPaidEnrollmentForStudent(resource.data.courseId, resource.data.studentUid))
        && request.resource.data.date == resource.data.date
        && request.resource.data.status in ['present','absent','late','excused']
        && request.resource.data.markedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId));
      allow delete: if isSuperAdmin();
    }

    match /instituteAssessments/{assessmentId} {
      allow create: if (isActiveInstituteCourse(request.resource.data.courseId))
        && (isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(request.resource.data.courseId))
        && request.resource.data.courseId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0
        && request.resource.data.questions.size() <= 30
        && request.resource.data.assessmentType in ['written','objective']
        && request.resource.data.published == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['courseId','courseTitle','title','instructions','dueDate','dueAt','questions','assessmentType','published','createdBy','createdAt','updatedAt']);
      // Published assessment content is immutable; create a new assessment to correct it.
      allow update: if false;
      allow read: if isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId)
        || (resource.data.published == true && hasPaidCourseAccess(resource.data.courseId));
      allow delete: if isSuperAdmin();
    }

    match /instituteAssessmentAnswerKeys/{assessmentId} {
      allow create: if (isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(request.resource.data.courseId))
        && request.resource.data.assessmentId == assessmentId
        && request.resource.data.courseId is string
        && request.resource.data.correctOptions is list
        && request.resource.data.correctOptions.size() > 0
        && request.resource.data.correctOptions.size() <= 30
        && request.resource.data.correctOptions.hasOnly(['A','B','C','D'])
        && existsAfter(/databases/$(database)/documents/instituteAssessments/$(assessmentId))
        && getAfter(/databases/$(database)/documents/instituteAssessments/$(assessmentId)).data.courseId == request.resource.data.courseId
        && getAfter(/databases/$(database)/documents/instituteAssessments/$(assessmentId)).data.assessmentType == 'objective'
        && getAfter(/databases/$(database)/documents/instituteAssessments/$(assessmentId)).data.createdBy == request.resource.data.createdBy
        && getAfter(/databases/$(database)/documents/instituteAssessments/$(assessmentId)).data.questions.size() == request.resource.data.correctOptions.size()
        && request.resource.data.pointsPerQuestion == 10
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['assessmentId','courseId','correctOptions','pointsPerQuestion','createdBy','createdAt']);
      allow read: if isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId);
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /instituteAssessmentSubmissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && hasPaidCourseAccess(request.resource.data.courseId)
        && request.resource.data.status == 'submitted'
        && request.resource.data.answers is list
        && request.resource.data.answers.size() > 0
        && exists(/databases/$(database)/documents/instituteAssessments/$(request.resource.data.assessmentId))
        && get(/databases/$(database)/documents/instituteAssessments/$(request.resource.data.assessmentId)).data.courseId == request.resource.data.courseId
        && get(/databases/$(database)/documents/instituteAssessments/$(request.resource.data.assessmentId)).data.published == true
        && (!get(/databases/$(database)/documents/instituteAssessments/$(request.resource.data.assessmentId)).data.keys().hasAny(['assessmentType']) || get(/databases/$(database)/documents/instituteAssessments/$(request.resource.data.assessmentId)).data.assessmentType == 'written')
        && (!get(/databases/$(database)/documents/instituteAssessments/$(request.resource.data.assessmentId)).data.keys().hasAny(['dueAt']) || get(/databases/$(database)/documents/instituteAssessments/$(request.resource.data.assessmentId)).data.dueAt == null || request.time <= get(/databases/$(database)/documents/instituteAssessments/$(request.resource.data.assessmentId)).data.dueAt)
        && request.resource.data.answers.size() == get(/databases/$(database)/documents/instituteAssessments/$(request.resource.data.assessmentId)).data.questions.size()
        && request.resource.data.keys().hasOnly(['assessmentId','courseId','assessmentTitle','studentUid','studentName','answers','status','submittedAt','createdAt','updatedAt'])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId));
      allow update: if (isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','score','maxScore','feedback','gradedBy','gradedAt','updatedAt'])
        && request.resource.data.status == 'graded'
        && request.resource.data.score is number
        && request.resource.data.maxScore is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.maxScore
        && request.resource.data.gradedBy == request.auth.uid
        && (isSuperAdmin() || hasStaffRole(['institute','manager']) || hasInstructorCourseAccess(resource.data.courseId))
        && exists(/databases/$(database)/documents/instituteAssessments/$(resource.data.assessmentId))
        && get(/databases/$(database)/documents/instituteAssessments/$(resource.data.assessmentId)).data.courseId == resource.data.courseId
        && request.resource.data.maxScore == get(/databases/$(database)/documents/instituteAssessments/$(resource.data.assessmentId)).data.questions.size() * 10
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSuperAdmin();
    }

    match /instituteInstructorProfiles/{instructorUid} {
      allow create: if signedIn()
        && request.auth.uid == instructorUid
        && roleOf(instructorUid) == 'instructor'
        && request.resource.data.instructorUid == instructorUid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.qualifications is string
        && request.resource.data.specialization is string
        && request.resource.data.bio is string
        && request.resource.data.availability is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['instructorUid','fullName','phone','qualifications','specialization','bio','availability','createdAt','updatedAt']);
      allow read: if signedIn() && (request.auth.uid == instructorUid || isSuperAdmin() || hasStaffRole(['institute','manager']));
      allow update: if signedIn()
        && request.auth.uid == instructorUid
        && roleOf(instructorUid) == 'instructor'
        && request.resource.data.instructorUid == resource.data.instructorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','phone','qualifications','specialization','bio','availability','updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.qualifications is string
        && request.resource.data.specialization is string
        && request.resource.data.bio is string
        && request.resource.data.availability is string
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSuperAdmin();
    }

    match /instituteInstructorAssignments/{assignmentId} {
      allow create, update: if (isSuperAdmin() || hasStaffRole(['institute','manager']))
        && (request.resource.data.active != true || isActiveInstituteCourse(request.resource.data.courseId))
        && request.resource.data.instructorUid is string
        && roleOf(request.resource.data.instructorUid) == 'instructor'
        && request.resource.data.courseId is string
        && exists(/databases/$(database)/documents/instituteCourses/$(request.resource.data.courseId))
        && assignmentId == request.resource.data.instructorUid + '_' + request.resource.data.courseId
        && request.resource.data.active is bool
        && request.resource.data.assignedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['instructorUid','courseId','courseTitle','active','assignedBy','assignedAt','updatedAt']);
      allow read: if signedIn() && (resource.data.instructorUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['institute','manager']));
      allow delete: if isSuperAdmin();
    }

    match /siteMedia/{mediaId} {
      function validSiteMedia(data) {
        return data.keys().hasOnly(['title','description','category','mediaType','fileName','contentType','size','driveFileId','driveUrl','previewUrl','drivePreviewUrl','visibility','published','uploadedByUid','createdAt','updatedAt'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 100
          && data.description is string && data.description.size() <= 500
          && data.category in ['Collections','Fashion shows','Promotional videos','Training','Company news','Gallery','Company theme song']
          && data.mediaType in ['image','video','audio']
          && data.fileName is string && data.contentType in ['image/jpeg','image/png','image/webp','video/mp4','video/webm','video/quicktime','audio/mpeg','audio/mp4','audio/wav','audio/ogg']
          && data.size is int && data.size > 0
          && ((data.mediaType == 'image' && data.size <= 20971520) || (data.mediaType == 'video' && data.size <= 104857600) || (data.mediaType == 'audio' && data.size <= 52428800))
          && ((data.mediaType == 'audio' && data.category == 'Company theme song') || (data.mediaType != 'audio' && data.category != 'Company theme song'))
          && data.driveFileId is string && data.driveUrl is string && data.previewUrl is string && data.drivePreviewUrl is string
          && data.visibility == 'public' && data.published is bool && data.uploadedByUid == request.auth.uid;
      }
      allow read: if (resource.data.published == true && resource.data.visibility == 'public')
        || isSuperAdmin() || hasStaffRole(['manager']);
      allow create: if (isSuperAdmin() || hasStaffRole(['manager']))
        && validSiteMedia(request.resource.data)
        && request.resource.data.published == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if (isSuperAdmin() || hasStaffRole(['manager']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published','updatedAt'])
        && request.resource.data.published is bool
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSuperAdmin() || hasStaffRole(['manager']);
    }

    match /customerBenefits/{customerUid} {
      function validBenefits(data) {
        return data.keys().hasOnly(['customerUid','points','tier','discountPercent','prioritySupport','createdAt','updatedAt','updatedBy'])
          && data.customerUid == customerUid
          && data.points is int && data.points >= 0
          && data.tier in ['standard','silver','gold','vip']
          && data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 50
          && data.prioritySupport is bool
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && data.updatedBy is string;
      }
      allow read: if signedIn() && (request.auth.uid == customerUid || isSuperAdmin());
      allow create: if isSuperAdmin()
        && validBenefits(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isSuperAdmin()
        && validBenefits(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /loyaltyTransactions/{transactionId} {
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin());
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['customerUid','pointsDelta','reason','createdAt','createdBy'])
        && request.resource.data.customerUid is string
        && request.resource.data.pointsDelta is int
        && request.resource.data.pointsDelta != 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /publicFAQs/{faqId} {
      function validFAQ(data) {
        return data.keys().hasOnly(['question','answer','order','active','createdAt','createdBy','updatedAt'])
          && data.question is string && data.question.size() >= 8 && data.question.size() <= 180
          && data.answer is string && data.answer.size() >= 15 && data.answer.size() <= 1800
          && data.order is int && data.order >= 0 && data.order <= 999
          && data.active is bool
          && data.createdAt is timestamp && data.createdBy is string
          && data.updatedAt is timestamp;
      }
      allow read: if resource.data.active == true || isSuperAdmin() || hasStaffRole(['manager']);
      allow create: if (isSuperAdmin() || hasStaffRole(['manager']))
        && validFAQ(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isSuperAdmin() || hasStaffRole(['manager']))
        && validFAQ(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow create: if signedIn()
        && (isSuperAdmin() || isStaff() || isFinanceOfficer() || roleOf(request.auth.uid) == 'instructor')
        && request.resource.data.keys().hasOnly(['actorUid','actorRole','action','entityType','entityId','summary','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == roleOf(request.auth.uid)
        && request.resource.data.action in ['customer_benefits_updated','referral_reviewed','corporate_request_updated','fabric_created','fabric_updated','fabric_archived','privacy_request_updated','refund_status_updated','payment_declaration_reviewed','appointment_status_updated','staff_role_assigned','inventory_stock_adjusted','company_profile_updated','payment_instructions_updated','appointment_assignment_updated','designer_availability_updated','institute_application_reviewed','training_payment_verified','institute_enrollment_withdrawn','drive_lesson_access_granted','drive_lesson_access_revoked','order_assigned','order_production_updated','order_delivery_date_updated','faq_created','faq_updated','faq_archived']
        && request.resource.data.entityType in ['customerBenefits','referral','corporateRequest','fabric','privacyRequest','paymentDeclaration','appointment','role','product','companyProfile','paymentInstructions','refund','designerAvailability','instituteApplication','instituteEnrollment','order','faq']
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() <= 150
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 500
        && request.resource.data.createdAt is timestamp;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /corporateRequests/{requestId} {
      allow create: if signedIn()
        && roleOf(request.auth.uid) == 'customer'
        && request.resource.data.keys().hasOnly(['customerUid','customerEmail','customerName','organisation','contactName','phone','requestType','quantity','preferredDueDate','location','details','status','staffNote','createdAt','updatedAt'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.organisation is string && request.resource.data.organisation.size() >= 2 && request.resource.data.organisation.size() <= 160
        && request.resource.data.contactName is string && request.resource.data.contactName.size() >= 2 && request.resource.data.contactName.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 30
        && request.resource.data.requestType in ['Corporate uniforms','School uniforms','Church / ministry outfits','Wedding party clothing','Event clothing','Bulk bespoke garments','Other institutional order']
        && request.resource.data.quantity is int && request.resource.data.quantity >= 2 && request.resource.data.quantity <= 10000
        && request.resource.data.preferredDueDate is string && request.resource.data.preferredDueDate.size() <= 10
        && request.resource.data.location is string && request.resource.data.location.size() <= 200
        && request.resource.data.details is string && request.resource.data.details.size() >= 10 && request.resource.data.details.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.staffNote == ''
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['manager']));
      allow update: if (isSuperAdmin() || hasStaffRole(['manager']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','staffNote','updatedBy','updatedAt'])
        && request.resource.data.status in ['pending','in_review','quotation_preparation','quoted','accepted','declined','completed']
        && request.resource.data.staffNote is string && request.resource.data.staffNote.size() <= 1500
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSuperAdmin();
    }

    match /referralClaims/{referralId} {
      allow create: if signedIn()
        && roleOf(request.auth.uid) == 'customer'
        && request.resource.data.keys().hasOnly(['customerUid','referrerEmail','referralCode','referredName','referredEmail','referredPhone','note','status','reviewNote','createdAt','updatedAt'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.referrerEmail == request.auth.token.email
        && request.resource.data.referralCode is string
        && request.resource.data.referralCode.size() <= 30
        && request.resource.data.referredName is string
        && request.resource.data.referredName.size() >= 2
        && request.resource.data.referredName.size() <= 100
        && request.resource.data.referredEmail is string
        && request.resource.data.referredEmail.size() <= 254
        && request.resource.data.referredEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.referredEmail != request.auth.token.email
        && request.resource.data.referredPhone is string
        && request.resource.data.referredPhone.size() <= 30
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewNote == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin());
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','reviewedBy','updatedAt'])
        && request.resource.data.status in ['pending','contacted','qualified','rewarded','declined']
        && request.resource.data.reviewNote is string
        && request.resource.data.reviewNote.size() <= 500
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSuperAdmin();
    }

    match /fabrics/{fabricId} {
      function validFabric(data) {
        return data.keys().hasOnly(['name','color','texture','priceRange','availability','suitableCategories','imageUrl','active','createdAt','createdBy','updatedAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.color is string && data.color.size() > 0 && data.color.size() <= 80
          && data.texture is string && data.texture.size() > 0 && data.texture.size() <= 100
          && data.priceRange is string && data.priceRange.size() <= 100
          && data.availability in ['available','limited','out_of_stock']
          && data.suitableCategories is list && data.suitableCategories.size() <= 12
          && data.imageUrl is string && data.imageUrl.size() <= 1500
          && (data.imageUrl == '' || data.imageUrl.matches('https://.*'))
          && data.active is bool
          && data.createdAt is timestamp && data.createdBy is string
          && data.updatedAt is timestamp;
      }
      allow read: if resource.data.active == true || isSuperAdmin();
      allow create: if isSuperAdmin()
        && validFabric(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSuperAdmin()
        && validFabric(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /privacyRequests/{requestId} {
      allow create: if signedIn()
        && roleOf(request.auth.uid) == 'customer'
        && request.resource.data.keys().hasOnly(['customerUid','customerEmail','requestType','details','status','staffNote','createdAt','updatedAt'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.requestType in ['access','correction','deletion']
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 10
        && request.resource.data.details.size() <= 1500
        && request.resource.data.status == 'received'
        && request.resource.data.staffNote == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin());
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','staffNote','reviewedBy','updatedAt'])
        && request.resource.data.status in ['received','reviewing','completed','unable_to_fulfil']
        && request.resource.data.staffNote is string
        && request.resource.data.staffNote.size() <= 1500
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSuperAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
