rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function rolePath(uid) { return /databases/$(database)/documents/roles/$(uid); }
    function roleOf(uid) {
      return exists(rolePath(uid)) ? get(rolePath(uid)).data.role : 'customer';
    }
    function isSuperAdmin() { return signedIn() && roleOf(request.auth.uid) == 'superAdmin'; }
    function isStaff() {
      return signedIn() && roleOf(request.auth.uid) in ['manager', 'sales', 'tailor', 'institute'];
    }
    function hasStaffRole(roles) { return isStaff() && roleOf(request.auth.uid) in roles; }

    match /roles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin() && userId != request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.accountType == 'customer'
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'accountType', 'createdAt', 'updatedAt']);
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin() || hasStaffRole(['manager', 'sales']));
      allow update: if (signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'address', 'updatedAt']))
        || (isSuperAdmin() && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'address', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && (
        (request.resource.data.customerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['customerUid', 'customerName', 'customerEmail', 'orderNumber', 'item', 'description', 'category', 'fabric', 'colour', 'quantity', 'measurementMethod', 'preferredDate', 'deliveryMethod', 'instructions', 'status', 'paymentStatus', 'createdAt', 'updatedAt'])
          && request.resource.data.item is string && request.resource.data.item.size() > 0
          && request.resource.data.item.size() <= 120
          && request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 50
          && request.resource.data.status == 'received'
          && request.resource.data.paymentStatus == 'unquoted'
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
        ) || (isSuperAdmin()
          && request.resource.data.keys().hasOnly(['orderNumber', 'customerUid', 'customerName', 'customerEmail', 'item', 'description', 'amount', 'currency', 'dueDate', 'status', 'paymentStatus', 'createdAt', 'updatedAt', 'createdBy'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
        )
      );
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || isStaff());
      allow update: if (signedIn() && resource.data.customerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['instructions', 'fabric', 'colour', 'preferredDate', 'deliveryMethod', 'updatedAt'])
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus)
        || (isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'amount', 'quotationNote', 'quotationStatus', 'quotationSentAt', 'updatedAt'])
        && (!('amount' in request.resource.data) || (request.resource.data.amount is number && request.resource.data.amount > 0))
        && (!('quotationStatus' in request.resource.data) || request.resource.data.quotationStatus in ['sent', 'accepted', 'declined']))
        || (signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.quotationStatus == 'sent'
        && request.resource.data.quotationStatus in ['accepted', 'declined']
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quotationStatus', 'updatedAt']))
        || (hasStaffRole(['manager', 'sales', 'tailor'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isSuperAdmin();

      match /events/{eventId} {
        allow create: if isSuperAdmin()
          && request.resource.data.keys().hasOnly(['fromStatus', 'toStatus', 'stageLabel', 'changedByUid', 'changedByName', 'createdAt'])
          && request.resource.data.changedByUid == request.auth.uid
          && request.resource.data.fromStatus is string
          && request.resource.data.toStatus in ['received', 'designer_review', 'awaiting_measurements', 'measurements_completed', 'awaiting_quotation_approval', 'awaiting_deposit', 'confirmed', 'fabric_preparation', 'cutting', 'sewing', 'finishing', 'quality_control', 'ready_for_fitting', 'alterations', 'completed', 'ready_for_collection', 'dispatched', 'delivered']
          && request.resource.data.stageLabel is string
          && request.resource.data.createdAt is timestamp;
        allow read: if signedIn() && (
          isSuperAdmin() || isStaff() ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
        );
        allow update, delete: if false;
      }
    }

    match /appointments/{appointmentId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['customerUid', 'customerName', 'customerEmail', 'service', 'appointmentDate', 'appointmentTime', 'purpose', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || isStaff());
      allow update: if (
        isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'proposedDate', 'proposedTime', 'adminMessage', 'updatedAt'])
        && request.resource.data.status in ['pending', 'confirmed', 'alternative_proposed', 'completed', 'cancelled']
        && (request.resource.data.status != 'alternative_proposed'
          || (request.resource.data.proposedDate is string
            && request.resource.data.proposedTime is string))
      ) || (
        signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'alternative_proposed'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.appointmentDate == resource.data.proposedDate
        && request.resource.data.appointmentTime == resource.data.proposedTime
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'appointmentDate', 'appointmentTime', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['orderId', 'orderNumber', 'customerUid', 'customerName', 'amount', 'currency', 'method', 'reference', 'note', 'createdAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || isStaff());
      allow update, delete: if isSuperAdmin();
    }


    match /expenses/{expenseId} {
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['title', 'category', 'amount', 'currency', 'expenseDate', 'method', 'note', 'createdAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.expenseDate is string
        && request.resource.data.category is string
        && request.resource.data.method is string;
      allow read: if isSuperAdmin() || hasStaffRole(['manager']);
      allow update, delete: if isSuperAdmin();
    }

    match /sales/{saleId} {
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['receiptNumber', 'customerName', 'items', 'subtotal', 'total', 'totalCost', 'grossProfit', 'amountPaid', 'balance', 'paymentStatus', 'paymentMethod', 'currency', 'createdAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.receiptNumber is string
        && request.resource.data.items is list
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.totalCost is number && request.resource.data.totalCost >= 0
        && request.resource.data.grossProfit is number
        && request.resource.data.amountPaid is number && request.resource.data.amountPaid >= 0
        && request.resource.data.balance is number && request.resource.data.balance >= 0
        && request.resource.data.paymentStatus in ['unpaid', 'part_paid', 'paid'];
      allow read: if isSuperAdmin() || hasStaffRole(['manager', 'sales']);
      allow update, delete: if isSuperAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['name', 'sku', 'category', 'description', 'price', 'costPrice', 'currency', 'stock', 'imageUrl', 'active', 'createdAt', 'updatedAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.sku is string
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.costPrice is number && request.resource.data.costPrice >= 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0;
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'sku', 'category', 'description', 'price', 'costPrice', 'imageUrl', 'active', 'stock', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.sku is string && request.resource.data.sku.size() > 0
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.costPrice is number && request.resource.data.costPrice >= 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0;
      allow delete: if isSuperAdmin();
    }

    match /inventoryMovements/{movementId} {
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['productId', 'productName', 'sku', 'type', 'quantity', 'previousStock', 'newStock', 'createdAt', 'createdBy', 'reason', 'receiptNumber'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ['in', 'out']
        && request.resource.data.quantity is int && request.resource.data.quantity > 0
        && request.resource.data.previousStock is int && request.resource.data.previousStock >= 0
        && request.resource.data.newStock is int && request.resource.data.newStock >= 0;
      allow read: if isSuperAdmin() || hasStaffRole(['manager']);
      allow update, delete: if isSuperAdmin();
    }

    match /measurements/{measurementId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['customerUid', 'customerName', 'profileName', 'garmentType', 'chest', 'waist', 'hip', 'shoulder', 'sleeve', 'length', 'neck', 'inseam', 'bicep', 'wrist', 'armhole', 'shirtLength', 'acrossBack', 'outseam', 'thigh', 'knee', 'ankle', 'frontRise', 'backRise', 'bust', 'underBust', 'bustPoint', 'dressLength', 'waistToHip', 'skirtLength', 'jacketLength', 'blouseLength', 'notes', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['manager', 'tailor']));
      allow update: if signedIn() && resource.data.customerUid == request.auth.uid
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerName', 'chest', 'waist', 'hip', 'shoulder', 'sleeve', 'length', 'neck', 'inseam', 'notes', 'updatedAt']);
      allow delete: if isSuperAdmin() || hasStaffRole(['manager', 'tailor']);
    }

    match /trainingEnquiries/{enquiryId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['customerUid', 'customerName', 'customerEmail', 'course', 'mode', 'message', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isSuperAdmin() || hasStaffRole(['manager', 'institute']));
      allow update: if (isSuperAdmin() || hasStaffRole(['manager', 'institute']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'contacted', 'accepted', 'declined', 'completed'];
      allow delete: if isSuperAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
